# API base URL (no trailing slash).
# Dev: leave unset to call same-origin `/v1/...` via Vite proxy → https://staging.fastor.ai
# Production preview/build: defaults to https://staging.fastor.ai when unset.
# VITE_API_BASE_URL=https://staging.fastor.ai

# City ID for GET /v1/m/restaurant
VITE_RESTAURANT_CITY_ID=118
